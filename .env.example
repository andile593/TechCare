# Server
NODE_ENV=development
PORT=4000

# Database (local docker-compose default — override in each environment)
DATABASE_URL="postgresql://techcare:techcare@localhost:5432/techcare_dev?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-value-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"
JWT_REFRESH_EXPIRES_IN="7d"

# Logging
LOG_LEVEL="info"
